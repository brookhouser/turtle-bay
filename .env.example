# Copy this file to .env.local and fill in a Firebase web app.
# Leave the Firebase fields blank to play in demo mode (localStorage only).
# Do not commit .env.local. Web API keys are still not secret, but this repo
# should never contain a real project config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Two parent Google accounts, comma separated. Demo mode uses this list too.
# Matching is case-insensitive. These are Kevin and Beth.
VITE_PARENT_ALLOWLIST=brookhouser@gmail.com,bbrookhouser@gmail.com

# Shared Firestore family id for those parents and their kid bays.
VITE_FAMILY_ID=turtlebay

# Set to true to force demo mode even if Firebase keys are present.
VITE_FORCE_DEMO=
